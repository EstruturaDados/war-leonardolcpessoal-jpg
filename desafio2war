#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define MAX_NOME 50
#define MAX_COR 20
#define QTD_TERRITORIOS 5

typedef struct {
    char nome[MAX_NOME];
    char cor[MAX_COR];
    int tropas;
} Territorio;


// ---- CADASTRO ----
void cadastrarTerritorios(Territorio *mapa) {
    printf("=== CADASTRO DE TERRITÓRIOS (Nível Aventureiro) ===\n\n");

    for (int i = 0; i < QTD_TERRITORIOS; i++) {

        printf("Território %d:\n", i + 1);

        printf("Nome: ");
        fgets(mapa[i].nome, MAX_NOME, stdin);
        mapa[i].nome[strcspn(mapa[i].nome, "\n")] = '\0';

        printf("Cor do Exército: ");
        fgets(mapa[i].cor, MAX_COR, stdin);
        mapa[i].cor[strcspn(mapa[i].cor, "\n")] = '\0';

        printf("Número de Tropas: ");
        scanf("%d", &mapa[i].tropas);
        getchar();

        printf("\n");
    }
}


// ---- EXIBIÇÃO ----
void mostrarMapa(Territorio *mapa) {
    printf("\n=== ESTADO ATUAL DO MAPA ===\n\n");

    for (int i = 0; i < QTD_TERRITORIOS; i++) {
        printf("Território %d\n", i + 1);
        printf("Nome: %s\n", mapa[i].nome);
        printf("Exército: %s\n", mapa[i].cor);
        printf("Tropas: %d\n", mapa[i].tropas);
        printf("---------------------------\n");
    }
}


// ---- ATAQUE ----
void atacar(Territorio *mapa, int atacante, int defensor) {

    if (atacante == defensor) {
        printf("Um território não pode atacar a si mesmo!\n");
        return;
    }

    if (mapa[atacante].tropas < 1) {
        printf("O território atacante não possui tropas suficientes!\n");
        return;
    }

    if (mapa[defensor].tropas < 1) {
        printf("O território defensor já está sem tropas!\n");
        return;
    }

    int dadoAtq = rand() % 6 + 1;
    int dadoDef = rand() % 6 + 1;

    printf("\n🎲 Dados lançados!\n");
    printf("%s (ATQ) rolou: %d\n", mapa[atacante].nome, dadoAtq);
    printf("%s (DEF) rolou: %d\n", mapa[defensor].nome, dadoDef);

    if (dadoAtq > dadoDef) {
        printf("✔ Ataque bem-sucedido! O defensor perde 1 tropa.\n");
        mapa[defensor].tropas--;

        if (mapa[defensor].tropas <= 0) {
            printf("🏳 O território %s foi conquistado!\n", mapa[defensor].nome);

            // Conquista: cores e tropas substituídas
            strcpy(mapa[defensor].cor, mapa[atacante].cor);
            mapa[defensor].tropas = 1;
            mapa[atacante].tropas--;  
        }

    } else if (dadoDef > dadoAtq) {
        printf("❌ Defesa bem-sucedida! O atacante perde 1 tropa.\n");
        mapa[atacante].tropas--;

    } else {
        printf("😐 Empate! Ninguém perde tropas.\n");
    }
}


// ---- MAIN ----
int main() {
    srand(time(NULL));  // Inicializa aleatoriedade

    Territorio *mapa = (Territorio *) calloc(QTD_TERRITORIOS, sizeof(Territorio));
    if (mapa == NULL) {
        printf("Erro ao alocar memória!\n");
        return 1;
    }

    cadastrarTerritorios(mapa);
    mostrarMapa(mapa);

    int op;
    do {
        printf("\n=== FASE DE ATAQUE ===\n");
        printf("1 - Atacar\n");
        printf("0 - Sair\n");
        printf("Escolha: ");
        scanf("%d", &op);
        getchar();

        if (op == 1) {
            int atq, def;

            printf("Escolha o território ATACANTE (1 a 5): ");
            scanf("%d", &atq);
            getchar();

            printf("Escolha o território DEFENSOR (1 a 5): ");
            scanf("%d", &def);
            getchar();

            atacar(mapa, atq - 1, def - 1);
            mostrarMapa(mapa);
        }

    } while (op != 0);

    free(mapa);

    printf("\nJogo finalizado.\n");
    return 0;
}
